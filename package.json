{
  "name": "agent-gateway",
  "version": "3.0.10",
  "description": "Windows desktop gateway and local HTTP API for coding agents; the current provider is the OpenAI Codex SDK",
  "author": {
    "name": "Agent Gateway Contributors",
    "url": "https://github.com/daizhongtian/Agent-Gateway"
  },
  "license": "MIT",
  "copyright": "Copyright © 2026 Agent Gateway Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daizhongtian/Agent-Gateway.git"
  },
  "homepage": "https://github.com/daizhongtian/Agent-Gateway#readme",
  "bugs": {
    "url": "https://github.com/daizhongtian/Agent-Gateway/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node src/server/standalone.js",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 node scripts/run-tests.mjs && node scripts/check-desktop-coverage.mjs",
    "test:coverage:changed": "node scripts/check-changed-coverage.mjs",
    "test:platform:backend": "node scripts/run-platform-backend-tests.mjs",
    "test:platform:frontend": "npm --prefix platform/frontend run test:coverage",
    "test:platform": "npm run test:platform:backend && npm run test:platform:frontend && npm --prefix platform/frontend run check && npm --prefix platform/frontend run build",
    "test:e2e:platform": "npm --prefix platform/frontend run test:e2e",
    "test:live:gateway": "node scripts/live-gateway-smoke.mjs",
    "test:all": "npm run test:coverage && npm run test:platform && npm run test:coverage:changed",
    "test:visual": "node test/visual-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:packaged:fresh": "node scripts/run-packaged-tests.mjs",
    "security:contract": "node scripts/security/validate-api-permissions.mjs && node scripts/security/static-security-check.mjs",
    "security:dependencies": "node scripts/security/run-npm-audit.mjs && npm --prefix platform/frontend audit --audit-level=high && node scripts/security/run-maven-audit.mjs",
    "security:dast:quick": "node scripts/security/platform-dast.mjs --quick",
    "security:dast": "node scripts/security/platform-dast.mjs",
    "security:all": "npm run security:contract && npm run security:dependencies && npm run test:all && npm run security:dast",
    "performance": "node performance-tests/run.mjs --suite local",
    "performance:all": "node performance-tests/run.mjs --suite full",
    "performance:smoke": "node performance-tests/run.mjs --profile smoke --no-platform --no-browser",
    "performance:baseline": "node performance-tests/run.mjs --profile baseline",
    "performance:baseline:update": "node performance-tests/run.mjs --profile baseline --write-baseline performance-tests/baselines/local.json",
    "performance:regression": "node performance-tests/run.mjs --profile baseline --baseline performance-tests/baselines/local.json",
    "performance:normal": "node performance-tests/run.mjs --profile normal",
    "performance:spike": "node performance-tests/run.mjs --profile spike",
    "performance:stress": "node performance-tests/run.mjs --profile stress",
    "performance:soak": "node performance-tests/run.mjs --profile soak",
    "performance:fault": "node performance-tests/run.mjs --profile fault",
    "performance:desktop": "node performance-tests/desktop.mjs",
    "performance:real-provider": "node performance-tests/real-provider-smoke.mjs",
    "performance:fake-provider": "node performance-tests/fake-ai-provider.mjs",
    "check": "node scripts/check-syntax.mjs",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "check:release": "node scripts/check-release.mjs",
    "checksums": "node scripts/write-checksums.mjs",
    "dist": "npm run dist:all",
    "dist:portable": "npm run check:release && electron-builder --win portable --x64 --publish never",
    "dist:setup": "npm run check:release && electron-builder --win nsis --x64 --publish never",
    "dist:all": "npm run check:release && electron-builder --win portable nsis --x64 --publish never"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.4",
    "electron-updater": "6.8.9",
    "express": "5.2.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^5.4.624",
    "proper-lockfile": "4.1.2",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "build": {
    "appId": "com.daizhongtian.codexcontrolcenter",
    "productName": "Agent Gateway",
    "copyright": "Copyright © 2026 Agent Gateway Contributors",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "LOCAL_TERMS.md",
      "LOCAL_TERMS.zh-CN.md",
      "PLATFORM_TERMS.md",
      "PLATFORM_TERMS.zh-CN.md",
      "PLATFORM_PRIVACY.md",
      "PLATFORM_PRIVACY.zh-CN.md",
      "PRIVACY.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/openapi.yaml"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-win32-*/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "icon": "build/icon.ico",
      "protocols": [
        {
          "name": "Agent Gateway",
          "schemes": [
            "agent-gateway"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Agent-Gateway-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Gateway",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Agent Gateway",
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Agent-Gateway-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "daizhongtian",
        "repo": "Agent-Gateway",
        "releaseType": "release"
      }
    ]
  }
}
