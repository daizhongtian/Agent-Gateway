{
  "name": "codex-control-center",
  "version": "1.0.4",
  "description": "Windows desktop control center and local HTTP API for the OpenAI Codex SDK",
  "author": {
    "name": "Codex Control Center Contributors",
    "url": "https://github.com/daizhongtian/codex_sdk"
  },
  "license": "MIT",
  "copyright": "Copyright © 2026 Codex Control Center Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daizhongtian/codex_sdk.git"
  },
  "homepage": "https://github.com/daizhongtian/codex_sdk#readme",
  "bugs": {
    "url": "https://github.com/daizhongtian/codex_sdk/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node src/server/standalone.js",
    "test": "node scripts/run-tests.mjs",
    "test:visual": "node test/visual-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "check": "node scripts/check-syntax.mjs",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "check:release": "node scripts/check-release.mjs",
    "checksums": "node scripts/write-checksums.mjs",
    "dist": "npm run dist:all",
    "dist:portable": "npm run check:release && electron-builder --win portable --x64 --publish never",
    "dist:setup": "npm run check:release && electron-builder --win nsis --x64 --publish never",
    "dist:all": "npm run check:release && electron-builder --win portable nsis --x64 --publish never"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.4",
    "express": "5.2.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^5.4.624",
    "proper-lockfile": "4.1.2",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "build": {
    "appId": "com.daizhongtian.codexcontrolcenter",
    "productName": "Codex Control Center",
    "copyright": "Copyright © 2026 Codex Control Center Contributors",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "PRIVACY.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/openapi.yaml"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-win32-*/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Codex-Control-Center-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Control Center",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Codex Control Center",
      "license": "LICENSE",
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Codex-Control-Center-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "daizhongtian",
        "repo": "codex_sdk",
        "releaseType": "release"
      }
    ]
  }
}
