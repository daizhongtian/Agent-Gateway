# PostgreSQL
POSTGRES_DB=codex_platform
POSTGRES_USER=codex_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_SIZE=10

# Browser control plane. Set this to the final HTTPS console origin.
FRONTEND_ORIGIN=http://localhost:8088
# Use framework only when the backend is reachable exclusively through the trusted reverse proxy.
FORWARD_HEADERS_STRATEGY=framework

# Public Host allocation. A wildcard DNS record and TLS certificate are required later.
PUBLIC_HOST_DOMAIN=api.example.com
# Local V3 preview URL. A deployed relay can later replace only this template.
PUBLIC_HOST_URL_TEMPLATE=http://localhost:8088/h/{slug}/v1

# Relay is intentionally disabled until the public relay service is configured.
RELAY_URL=wss://relay.example.com/agent
RELAY_ENABLED=false

# V3 local preview: proxy the three OpenAI-compatible routes to the desktop Gateway.
LOCAL_PROXY_ENABLED=true
LOCAL_GATEWAY_BASE_URL=http://host.docker.internal:4310

# Set true only when the platform is served through HTTPS.
SECURE_COOKIES=false

# Session and enrollment policy
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PAIRING_CODE_TTL=10m
MAX_SESSIONS_PER_USER=10
MAX_DEVICES_PER_USER=10
MAX_HOSTS_PER_USER=10
