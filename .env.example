# Electron 内置服务始终绑定到 127.0.0.1；0 表示自动分配空闲端口。
CODEX_DESKTOP_PORT=0

# 独立 HTTP 服务。远程部署时通常改为 0.0.0.0，并放在 TLS 反向代理后。
HOST=127.0.0.1
PORT=4310

# 本机开发可用 none；任何非回环部署都必须使用 token（未来可扩展 oidc）。
AUTH_MODE=none
API_TOKEN=

# Codex Gateway API Key 的哈希存储文件。桌面版自动使用 Electron userData 目录。
API_KEY_STORE_PATH=

# 跨重启累计的任务与 Token 用量统计；在 Dashboard 中可手动 Reset。
USAGE_STORE_PATH=

# 逗号分隔。留空表示由服务端采用安全默认值。
ALLOWED_PROJECT_ROOTS=
CORS_ORIGINS=

# 可选：无项目任务的隔离临时目录根路径；留空时使用系统临时目录。
SCRATCH_ROOT=

# 图片与通用附件的临时上传。默认单文件 25 MiB、单任务 12 个文件/4 张图片/合计 100 MiB。
ATTACHMENT_UPLOAD_ROOT=
MAX_TASK_FILES=12
MAX_TASK_IMAGES=4
MAX_FILE_BYTES=26214400
MAX_TASK_ATTACHMENT_BYTES=104857600
ATTACHMENT_UPLOAD_TTL_MS=1800000

# 反向代理、并发和任务限制。
TRUST_PROXY=false
MAX_CONCURRENT_TASKS=2
MAX_QUEUED_TASKS=50
MAX_SSE_CONNECTIONS=100
TASK_TIMEOUT_MS=1800000
TASK_HISTORY_LIMIT=200
EVENT_HISTORY_LIMIT=500
EVENT_HISTORY_BYTES=2097152
LOG_LEVEL=info

# 非回环部署默认禁用；即使启用，调用 token 仍需相应 scope。
ALLOW_DANGEROUS_TASKS=false
ALLOW_TASK_NETWORK=false

# 可选：Codex SDK 访问模型服务使用的 OpenAI API key；它与 Gateway API Key 不同。
# 不要把真实密钥提交到版本库。
OPENAI_API_KEY=
